{
  "id": "guess-matrix-walk",
  "signature": {
    "function": "solve",
    "params": [
      {"name": "A", "type": "INT32", "role": "INPUT", "memory": "DEVICE", "size": "N*N"},
      {"name": "R", "type": "INT64", "role": "OUTPUT", "memory": "DEVICE", "size": "1"},
      {"name": "N", "type": "INT32", "role": "SCALAR"}
    ]
  },
  "checker": {"mode": "EXACT"},
  "limits": {"timeLimitMs": 1000, "memoryLimitMb": 4096, "gpuMemoryLimitMb": 2048},
  "timing": {"warmupRuns": 1, "maxRuns": 3},
  "processors": [
    {"id": "riscv-rvv", "languages": ["c"], "limit": 250000000}
  ]
}
