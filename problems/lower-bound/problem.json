{
  "id": "lower-bound",
  "allowCustomTests": true,
  "signature": {
    "function": "solve",
    "params": [
      {"name": "A", "type": "INT32", "role": "INPUT", "memory": "DEVICE", "size": "N"},
      {"name": "Q", "type": "INT32", "role": "INPUT", "memory": "DEVICE", "size": "M"},
      {"name": "C", "type": "INT32", "role": "OUTPUT", "memory": "DEVICE", "size": "M"},
      {"name": "N", "type": "INT32", "role": "SCALAR"},
      {"name": "M", "type": "INT32", "role": "SCALAR"}
    ]
  },
  "checker": {"mode": "EXACT"},
  "limits": {"timeLimitMs": 1000, "memoryLimitMb": 4096, "gpuMemoryLimitMb": 2048},
  "timing": {"warmupRuns": 1, "maxRuns": 3},
  "processors": [
    {"id": "gpu-cuda", "languages": ["cuda"]},
    {"id": "rtl", "languages": ["systemverilog"], "limit": 3300000000, "rtl": {"dataMode": "MEMORY"}},
    {"id": "riscv-rvv", "languages": ["c", "cpp", "asm"], "limit": 68000000},
    {"id": "cuda-sim", "languages": ["cuda"], "limit": 51000},
    {"id": "coral-npu", "languages": ["c", "cpp"], "limit": 510000}
  ]
}
