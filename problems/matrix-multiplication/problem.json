{
  "id": "matrix-multiplication",
  "signature": {
    "function": "solve",
    "params": [
      {"name": "A", "type": "FLOAT32", "role": "INPUT", "memory": "DEVICE", "size": "M*K"},
      {"name": "B", "type": "FLOAT32", "role": "INPUT", "memory": "DEVICE", "size": "K*N"},
      {"name": "C", "type": "FLOAT32", "role": "OUTPUT", "memory": "DEVICE", "size": "M*N"},
      {"name": "M", "type": "INT32", "role": "SCALAR"},
      {"name": "K", "type": "INT32", "role": "SCALAR"},
      {"name": "N", "type": "INT32", "role": "SCALAR"}
    ]
  },
  "checker": {"mode": "TOLERANCE", "rtol": 1e-3, "atol": 1e-3},
  "limits": {"timeLimitMs": 2000, "memoryLimitMb": 4096, "gpuMemoryLimitMb": 4096},
  "timing": {"warmupRuns": 1, "maxRuns": 3},
  "processors": [
    {"id": "gpu-cuda", "languages": ["cuda"]},
    {"id": "rtl", "languages": ["systemverilog"], "limit": 10000000000000},
    {"id": "riscv-rvv", "languages": ["c", "cpp", "asm"], "limit": 100000000}
  ]
}
