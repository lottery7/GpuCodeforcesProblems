{
  "id": "sieve",
  "allowCustomTests": true,
  "signature": {
    "function": "solve",
    "params": [
      {"name": "C", "type": "UINT8", "role": "OUTPUT", "memory": "DEVICE", "size": "N"},
      {"name": "N", "type": "INT32", "role": "SCALAR"}
    ]
  },
  "checker": {"mode": "EXACT"},
  "limits": {"timeLimitMs": 1000, "memoryLimitMb": 4096, "gpuMemoryLimitMb": 2048},
  "timing": {"warmupRuns": 1, "maxRuns": 3},
  "processors": [
    {"id": "gpu-cuda", "languages": ["cuda"]},
    {"id": "riscv-rvv", "languages": ["c", "cpp", "asm"], "limit": 3700000},
    {"id": "cuda-sim", "languages": ["cuda"], "limit": 580000},
    {"id": "coral-npu", "languages": ["c", "cpp"], "limit": 780000}
  ]
}
