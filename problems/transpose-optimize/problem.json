{
  "id": "transpose-optimize",
  "signature": {
    "function": "solve",
    "params": [
      {"name": "A", "type": "FLOAT32", "role": "INPUT", "memory": "DEVICE", "size": "N*M"},
      {"name": "B", "type": "FLOAT32", "role": "OUTPUT", "memory": "DEVICE", "size": "M*N"},
      {"name": "N", "type": "INT32", "role": "SCALAR"},
      {"name": "M", "type": "INT32", "role": "SCALAR"}
    ]
  },
  "checker": {"mode": "EXACT"},
  "limits": {"timeLimitMs": 1000, "memoryLimitMb": 4096, "gpuMemoryLimitMb": 2048},
  "timing": {"warmupRuns": 1, "maxRuns": 3},
  "processors": [
    {"id": "riscv-rvv", "languages": ["c", "cpp", "asm"], "limit": 320000000}
  ]
}
