{
  "id": "vector-addition",
  "signature": {
    "function": "solve",
    "params": [
      {"name": "A", "type": "FLOAT32", "role": "INPUT", "memory": "DEVICE", "size": "N"},
      {"name": "B", "type": "FLOAT32", "role": "INPUT", "memory": "DEVICE", "size": "N"},
      {"name": "C", "type": "FLOAT32", "role": "OUTPUT", "memory": "DEVICE", "size": "N"},
      {"name": "N", "type": "INT32", "role": "SCALAR"}
    ]
  },
  "checker": {"mode": "TOLERANCE", "rtol": 1e-6, "atol": 1e-6},
  "limits": {"timeLimitMs": 1000, "memoryLimitMb": 4096, "gpuMemoryLimitMb": 2048},
  "timing": {"warmupRuns": 1, "maxRuns": 3},
  "processors": [
    {"id": "gpu-cuda", "languages": ["cuda"]},
    {"id": "rtl", "languages": ["systemverilog"], "limit": 20000000000},
    {"id": "riscv-rvv", "languages": ["c", "cpp", "asm"], "limit": 10000000},
    {"id": "cuda-sim", "languages": ["cuda"], "limit": 50000}
  ]
}
